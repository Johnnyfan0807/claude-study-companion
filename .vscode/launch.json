{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Claude Study Companion",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}
