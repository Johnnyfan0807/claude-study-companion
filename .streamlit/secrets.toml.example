# Copy this file to .streamlit/secrets.toml for local development.
# The real secrets.toml is ignored by Git.
ANTHROPIC_API_KEY = "replace_with_your_key"
CLAUDE_MODEL = "claude-haiku-4-5-20251001"

# Set true when each visitor should enter their own key (recommended for a public demo).
# If ANTHROPIC_API_KEY is present, the server key takes priority.
ALLOW_USER_API_KEY = true
